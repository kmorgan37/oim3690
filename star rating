<body>
    <label for="">Rating: <input type="number" id="ratingInput" min="3" min="0" max="5"/></label>
</body>
const rating = 3;
const container = document.querySelector('#stars');
let stars = '';

for (let i = 0; i < 5; i++) {
  if (i < rating) {
    stars += '★';
  } else {
    stars += '☆';
  }
}
container.textContent = stars; // ★★★☆☆